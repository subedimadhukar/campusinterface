<?xml version="1.0"?>
<ruleset name="CampusInterface">
	<description>WordPress coding standards for CampusInterface, with PHP 7.4 compatibility.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/build/*</exclude-pattern>
	<exclude-pattern>/dist/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="basepath" value="./"/>
	<arg name="colors"/>
	<arg name="parallel" value="8"/>
	<arg value="sp"/>

	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.7"/>

	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress-Docs"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="campusinterface"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="campusinterface"/>
			</property>
		</properties>
	</rule>

	<!-- The contrast checker is a CLI tool, not theme code. -->
	<rule ref="WordPress.Security.EscapeOutput">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/bin/*</exclude-pattern>
	</rule>
</ruleset>
