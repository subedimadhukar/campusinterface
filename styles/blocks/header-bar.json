{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"title": "Header bar",
	"slug": "campusinterface-header-bar",
	"blockTypes": [ "core/group" ],
	"styles": {
		"border": {
			"bottom": {
				"color": "var:preset|color|line",
				"style": "solid",
				"width": "1px"
			}
		},
		"color": {
			"background": "var:preset|color|base",
